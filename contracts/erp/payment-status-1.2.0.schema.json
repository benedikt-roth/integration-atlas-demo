{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/payment-status/1.2.0",
  "title": "Payment status",
  "x-interface-version": "1.2.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "invoiceId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed"
      ]
    },
    "changedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "eventId",
    "invoiceId",
    "status",
    "changedAt"
  ]
}
